#!/usr/bin/env bash
set -euo pipefail

SERVICE="no-sleep.service"

show_status() {
  if systemctl --user is-active --quiet "$SERVICE"; then
    if systemd-inhibit --list --no-pager | awk '
            $1 == "OpenCode" && $6 == "sleep" && $NF == "block" {
                print
                found = 1
            }
            END { exit !found }
        '; then
      echo "Sleep prevention is ACTIVE."
    else
      echo "WARNING: Service is running, but the sleep blocker is not confirmed."
      return 1
    fi
  else
    echo "Sleep prevention is INACTIVE."
  fi
}

case "${1:-status}" in
on)
  systemctl --user start "$SERVICE"
  echo "Sleep prevention requested."
  show_status
  ;;

off)
  systemctl --user stop "$SERVICE"
  echo "Normal sleep behavior restored."
  ;;

status)
  show_status
  ;;

*)
  echo "Usage: no-sleep {on|off|status}"
  exit 1
  ;;
esac
