#!/usr/bin/env bash
set -euo pipefail

# Hyprland exec-once has a smaller PATH than an interactive zsh shell.
# Include the directories used by workmux, OpenCode, and this script.
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.local/share/pnpm:$HOME/code/dotfiles/bin:$PATH"

# Place workspaces and workspaces.conf in the same directory.
SCRIPT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
CONFIG="${WORKSPACES_CONFIG:-$SCRIPT_DIR/workspaces.conf}"
ZSH_BIN="$(command -v zsh || true)"

usage() {
  cat <<'USAGE'
Usage: workspaces [start|open SESSION|sync|list]
  start          Create missing configured windows, then attach/switch to the first session
  open SESSION   Create missing windows in SESSION, then attach/switch to it
  sync           Create missing sessions/windows without changing the current session
  list           Display current tmux sessions/windows
Environment: WORKSPACES_CONFIG=/path/to/workspaces.conf
Existing processes are never killed or restarted. Configured window names are repaired.
Workmux sidebar starts after the first tmux attach (disable with WORKSPACES_WORKMUX_SIDEBAR=0).
USAGE
}

die()  { printf 'Error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'Warning: %s\n' "$*" >&2; }

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

expand_path() {
  case "$1" in
    '~') printf '%s' "$HOME" ;;
    '~/'*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Get the *actual tmux session ID* ($N) by comparing complete names.
# IDs are stable even if the current/attached session changes.
get_session_id() {
  local wanted="$1" name sid
  while IFS='|' read -r name sid; do
    if [[ "$name" == "$wanted" ]]; then
      printf '%s\n' "$sid"
      return 0
    fi
  done < <(tmux list-sessions -F '#{session_name}|#{session_id}' 2>/dev/null || true)
  return 1
}

# Locate the exact existing index and return its stable window ID (@N).
# Read the entire window listing without grep -q / head SIGPIPE surprises.
get_window_id() {
  local sid="$1" wanted="$2" idx wid
  while IFS='|' read -r idx wid; do
    if [[ "$idx" == "$wanted" ]]; then
      printf '%s\n' "$wid"
      return 0
    fi
  done < <(tmux list-windows -t "$sid" -F '#{window_index}|#{window_id}')
  return 1
}

fix_window_name() {
  local wid="$1" expected="$2" current
  # Both automatic rename and terminal-initiated rename can change labels.
  tmux set-option -w -t "$wid" automatic-rename off
  tmux set-option -w -t "$wid" allow-rename off
  current="$(tmux display-message -p -t "$wid" '#{window_name}')"
  if [[ "$current" != "$expected" ]]; then
    tmux rename-window -t "$wid" "$expected"
    printf 'Renamed window %s: %s -> %s (process preserved)\n' "$wid" "$current" "$expected" >&2
  fi
}

ensure_session() {
  local name="$1" root="$2" sid initial_index wid
  if sid="$(get_session_id "$name")"; then
    printf '%s\n' "$sid"
    return 0
  fi

  [[ -d "$root" ]] || root="$HOME"
  # -P returns the new session's stable ID, so subsequent commands never
  # depend on matching =name during first-time creation.
  sid="$(tmux new-session -dP -F '#{session_id}' -s "$name" -n shell -c "$root" "$ZSH_BIN -l")"
  tmux set-option -t "$sid" base-index 0
  tmux set-option -t "$sid" renumber-windows off

  initial_index="$(tmux list-windows -t "$sid" -F '#{window_index}')"
  if [[ "$initial_index" != 0 ]]; then
    tmux move-window -s "$sid:$initial_index" -t "$sid:0"
  fi
  wid="$(get_window_id "$sid" 0)" || die "New session $name has no window 0"
  fix_window_name "$wid" shell
  printf 'Created session %s with 0:shell\n' "$name" >&2
  printf '%s\n' "$sid"
}

ensure_window() {
  local sid="$1" label="$2" idx="$3" name="$4" dir="$5" command="$6"
  local wid startup quoted
  if wid="$(get_window_id "$sid" "$idx")"; then
    fix_window_name "$wid" "$name"
    return 0
  fi

  if [[ ! -d "$dir" ]]; then
    warn "Directory '$dir' missing for $label:$idx; using $HOME"
    dir="$HOME"
  fi

  if [[ -z "$command" ]]; then
    startup="$ZSH_BIN -l"
  else
    # Quote the entire command string as one argument to zsh -c.
    # Leave an interactive zsh when the startup command exits.
    printf -v quoted '%q' "$command; exec $ZSH_BIN -l"
    startup="$ZSH_BIN -lic $quoted"
  fi

  wid="$(tmux new-window -dP -F '#{window_id}' -t "$sid:$idx" -n "$name" -c "$dir" "$startup")"
  fix_window_name "$wid" "$name"
  printf 'Created %s:%s (%s)\n' "$label" "$idx" "$name"
}

reconcile() {
  local only="${1:-}" session idx name dir command extra sid found=0
  while IFS='|' read -r session idx name dir command extra || [[ -n "${session:-}" ]]; do
    session="$(trim "${session:-}")"
    [[ -z "$session" || "$session" == \#* ]] && continue
    idx="$(trim "${idx:-}")"
    name="$(trim "${name:-}")"
    dir="$(expand_path "$(trim "${dir:-}")")"
    command="$(trim "${command:-}")"
    [[ -n "$only" && "$session" != "$only" ]] && continue

    [[ "$session" =~ ^[A-Za-z0-9_-]+$ ]] || die "Invalid session name: $session"
    [[ "$idx" =~ ^(0|[1-9][0-9]*)$ ]] || die "Invalid window index in $session: $idx"
    [[ -n "$name" && -n "$dir" && -z "${extra:-}" ]] || die "Malformed config line for $session:$idx"

    ((found += 1))
    sid="$(ensure_session "$session" "$dir")"
    ensure_window "$sid" "$session" "$idx" "$name" "$dir" "$command"
  done < "$CONFIG"
  ((found > 0)) || die "No configured entries found${only:+ for $only}"
  # Arm sidebar startup for the next attach, or initialize now if a client
  # is already attached. Starting while all sessions are detached is too early.
  install_workmux_sidebar_startup
}

# OpenCode status hooks are installed once using `workmux setup --hooks`.
# A freshly created tmux server may contain all windows but have zero attached
# clients. Running `sidebar on` at that point can leave the sidebar invisible.
# Use a dedicated indexed client-attached hook so it starts AFTER Kitty attaches.
# This does not interfere with the hook workmux installs for new windows.
start_workmux_sidebar() {
  [[ "${WORKSPACES_WORKMUX_SIDEBAR:-1}" != 0 ]] || return 0
  if ! command -v workmux >/dev/null 2>&1; then
    warn "workmux not installed; workspace windows are still usable"
    return 0
  fi

  local wm_output
  if ! wm_output="$(WORKMUX_BACKEND=tmux workmux sidebar on 2>&1)"; then
    warn "workmux sidebar startup failed: $wm_output"
    return 0
  fi
  if ! wm_output="$(WORKMUX_BACKEND=tmux workmux sidebar filter all 2>&1)"; then
    warn "workmux all-session filter failed: $wm_output"
  fi
  if ! wm_output="$(WORKMUX_BACKEND=tmux workmux sidebar group session 2>&1)"; then
    warn "workmux session grouping failed: $wm_output"
  fi
}

install_workmux_sidebar_startup() {
  [[ "${WORKSPACES_WORKMUX_SIDEBAR:-1}" != 0 ]] || return 0
  command -v workmux >/dev/null 2>&1 || return 0

  # Install one named-by-index hook into this tmux server (not ~/.tmux.conf).
  # Re-running `workspaces sync` replaces this same hook; never accumulates any.
  # Passing the absolute script path avoids PATH differences in Hyprland/tmux.
  local script_path shell_cmd
  printf -v script_path '%q' "$(readlink -f -- "${BASH_SOURCE[0]}")"
  shell_cmd="WORKMUX_BACKEND=tmux $script_path sidebar-start"
  tmux set-hook -g 'client-attached[9001]' \
    "run-shell -b -d 1 \"$shell_cmd\""

  # If another tmux client is already present, we needn't wait for the hook.
  # This also makes `workspaces sync` from inside tmux repair a missing sidebar.
  if [[ -n "$(tmux list-clients -F '#{client_tty}' 2>/dev/null || true)" ]]; then
    start_workmux_sidebar
  else
    printf 'workmux sidebar will start after a tmux client attaches.\n'
  fi
}

attach_or_switch() {
  local target="$1" sid
  sid="$(get_session_id "$target")" || die "Session not found: $target"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$sid"
  else
    exec tmux attach-session -t "$sid"
  fi
}

[[ -r "$CONFIG" ]] || die "Config not readable: $CONFIG"
command -v tmux >/dev/null || die 'tmux is not installed'
[[ -n "$ZSH_BIN" ]] || die 'zsh is not installed'

case "${1:-start}" in
  start)
    reconcile
    first="$(awk -F'|' '/^[[:space:]]*[^#[:space:]]/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1); print $1; exit}' "$CONFIG")"
    attach_or_switch "$first"
    ;;
  open)
    [[ $# -eq 2 ]] || die 'Usage: workspaces open SESSION'
    reconcile "$2"
    attach_or_switch "$2"
    ;;
  sync) reconcile ;;
  sidebar-start) start_workmux_sidebar ;;
  list)
    if tmux list-sessions >/dev/null 2>&1; then
      tmux list-sessions -F '#{session_name}: #{session_windows} windows'
      tmux list-windows -a -F '  #{session_name}:#{window_index} #{window_name}'
    else
      printf 'No tmux sessions currently running.\n'
    fi
    ;;
  -h | --help | help) usage ;;
  *) usage; exit 2 ;;
esac
